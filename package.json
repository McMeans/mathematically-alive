{
  "name": "mathematically-alive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gate": ".claude/skills/coverage-gate/gate.sh",
    "data": "tsx --env-file-if-exists=.env.local scripts/fetch-season.ts",
    "fixture": "tsx --env-file-if-exists=.env.local scripts/make-fixture.ts",
    "cfp": "tsx --env-file-if-exists=.env.local scripts/fetch-cfp.ts",
    "fit-committee": "tsx scripts/fit-committee.ts",
    "pretypecheck": "tsx scripts/build-data.ts",
    "prelint": "tsx scripts/build-data.ts",
    "prebuild": "tsx scripts/build-data.ts"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
